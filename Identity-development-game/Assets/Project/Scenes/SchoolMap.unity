      objectReference: {fileID: 0}
    - target: {fileID: 5477417865548946234, guid: b10ed7a756007b7449ddf12f3e1f7ffd, type: 3}
      propertyPath: 'DialogueTexts.Array.data[1]'
      value: Ik word er altijd heel ontspannen van. Helaas ben ik al mijn boeken
